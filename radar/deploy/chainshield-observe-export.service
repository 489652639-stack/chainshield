[Unit]
Description=ChainShield read-only observation snapshot
After=chainshield-source-test.service chainshield-shadow.service

[Service]
Type=oneshot
User=chainshield-source-test
Group=chainshield-source-test
WorkingDirectory=/opt/chainshield
ExecStart=/usr/bin/python3 -B -m radar.observe_export
# Deployment creates /var/lib/chainshield-observe owner 996, group 997, mode 2750.
# setgid grants backend read access to this handoff only, not to either DB.
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/chainshield-source-test /var/lib/chainshield-shadow
ReadWritePaths=/var/lib/chainshield-observe
MemoryMax=96M
CPUQuota=15%
TasksMax=8
TimeoutStartSec=12

