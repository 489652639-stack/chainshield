[Unit]
Description=ChainShield Radar Paper Service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=chainshield
Group=chainshield
WorkingDirectory=/opt/chainshield
EnvironmentFile=/etc/chainshield/radar.env
ExecStart=/usr/bin/python3 -m radar.server --db /var/lib/chainshield/radar.sqlite3
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chainshield
MemoryMax=512M
TasksMax=48
[Install]
WantedBy=multi-user.target
