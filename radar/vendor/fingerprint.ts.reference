import { createHash } from 'crypto';

/**
 * Compute Jaccard similarity between two string sets.
 * Returns 0-1 where 1 = identical sets.
 */
export function jaccardSimilarity(a: Set<string>, b: Set<string>): number {
  if (a.size === 0 && b.size === 0) return 1;

  let intersection = 0;
  for (const item of a) {
    if (b.has(item)) intersection++;
  }

  const union = a.size + b.size - intersection;
  return union === 0 ? 0 : intersection / union;
}

/**
 * Compute trigram set from a string.
 * Used for fuzzy text similarity.
 */
export function trigrams(text: string): Set<string> {
  const normalized = text.toLowerCase().trim();
  const result = new Set<string>();
  for (let i = 0; i <= normalized.length - 3; i++) {
    result.add(normalized.slice(i, i + 3));
  }
  return result;
}

/**
 * Trigram similarity between two strings.
 * Returns 0-1 where 1 = identical.
 */
export function trigramSimilarity(a: string, b: string): number {
  return jaccardSimilarity(trigrams(a), trigrams(b));
}

/**
 * Generate a fingerprint hash for a narrative (for dedup).
 * Based on sorted source IDs + normalized title.
 */
export function narrativeFingerprint(
  title: string,
  sourceIds: string[],
): string {
  const normalizedTitle = title.toLowerCase().trim().replace(/\s+/g, ' ');
  const sortedSources = [...sourceIds].sort().join('|');
  const input = `${normalizedTitle}::${sortedSources}`;
  return createHash('sha256').update(input).digest('hex').slice(0, 16);
}

/**
 * Check if two narratives overlap above a threshold.
 * Uses max(jaccard on sources, trigram on title).
 */
export function narrativesOverlap(
  titleA: string,
  sourceIdsA: string[],
  titleB: string,
  sourceIdsB: string[],
  threshold: number = 0.70,
): boolean {
  const sourceOverlap = jaccardSimilarity(
    new Set(sourceIdsA),
    new Set(sourceIdsB),
  );
  const titleOverlap = trigramSimilarity(titleA, titleB);
  return Math.max(sourceOverlap, titleOverlap) >= threshold;
}

/**
 * Generate a short stable ID for a narrative.
 */
export function generateNarrativeSlug(title: string, date: Date): string {
  const dateStr = date.toISOString().slice(0, 10).replace(/-/g, '');
  const hash = createHash('sha256').update(title.toLowerCase()).digest('hex').slice(0, 6);
  return `narrative-${dateStr}-${hash}`;
}
